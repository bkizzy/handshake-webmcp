# Supabase is optional for local development. Without it, Handshake uses an
# in-memory repository and exposes a clear development-mode notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Transactional email. When omitted, invite links remain available to copy.
RESEND_API_KEY=
EMAIL_FROM=Handshake <agreements@example.com>

# The public base URL used in invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
